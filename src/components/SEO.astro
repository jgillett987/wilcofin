---
import { SITE, CONTACT, VERIFICATION } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  noindex?: boolean;
  structuredData?: object | object[];
}

const {
  title,
  description = SITE.shortDescription,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
  structuredData,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImage = new URL(image, SITE.url).toString();
const fullTitle = title === SITE.name ? SITE.name : `${title} | ${SITE.name}`;

// Default organization structured data — always included. Rich areaServed
// and audience blocks help Google understand *who* and *where* — critical
// for local ("financial advisor Brentwood TN") and audience-specific
// ("financial advisor for Southwest Airlines pilots") queries.
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['FinancialService', 'LocalBusiness'],
  '@id': `${SITE.url}#organization`,
  name: SITE.legalName,
  alternateName: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/logo.svg`,
  image: `${SITE.url}/og-default.png`,
  description: SITE.description,
  telephone: CONTACT.phone,
  email: CONTACT.email,
  priceRange: '$$',
  currenciesAccepted: 'USD',
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${CONTACT.addressLine1}, ${CONTACT.addressLine2}`,
    addressLocality: CONTACT.city,
    addressRegion: CONTACT.state,
    postalCode: CONTACT.zip,
    addressCountry: CONTACT.country,
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Williamson County, Tennessee' },
    { '@type': 'AdministrativeArea', name: 'Davidson County, Tennessee' },
    { '@type': 'City', name: 'Brentwood, Tennessee' },
    { '@type': 'City', name: 'Franklin, Tennessee' },
    { '@type': 'City', name: 'Nashville, Tennessee' },
    { '@type': 'State', name: 'Tennessee' },
  ],
  audience: [
    { '@type': 'Audience', audienceType: 'Families and Individuals' },
    { '@type': 'Audience', audienceType: 'Small Business Owners' },
    { '@type': 'Audience', audienceType: '401(k) Plan Sponsors' },
    { '@type': 'Audience', audienceType: 'Southwest Airlines Pilots' },
    { '@type': 'Audience', audienceType: 'Southwest Airlines Employees' },
    { '@type': 'Audience', audienceType: 'Airline Pilots' },
  ],
  knowsAbout: [
    'Fiduciary Investment Management',
    'Fee-Only Financial Planning',
    'Retirement Planning',
    'Estate Planning',
    'Charitable Planning',
    'Multi-Generational Planning',
    'Tax Planning',
    'Southwest Airlines Pilot Retirement Planning',
    'Airline Pilot Financial Planning',
    'SWA 401(k) and Profit Sharing',
    'FAA Age 65 Retirement Planning',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Advisory Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Investment Management' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Financial Planning' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Retirement Planning' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Estate Planning' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Charitable Planning' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Multi-Generational Planning' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Tax Planning' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'SWA Pilot & Employee Specialty Practice' } },
    ],
  },
  sameAs: ['https://www.linkedin.com/in/jongillett'],
};

const allStructured = [orgJsonLd, ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [])];
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonical} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} Articles`} href="/rss.xml" />

<meta name="theme-color" content="#011342" />
<meta name="author" content={author || SITE.legalName} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Geo tags for local SEO -->
<meta name="geo.region" content="US-TN" />
<meta name="geo.placename" content={`${CONTACT.city}, ${CONTACT.state}`} />

<!-- Search-engine ownership verification. Populated only when the
     corresponding value in consts.ts/VERIFICATION is non-empty. -->
{VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
{VERIFICATION.bing && <meta name="msvalidate.01" content={VERIFICATION.bing} />}

<script type="application/ld+json" set:html={JSON.stringify(allStructured)} />
